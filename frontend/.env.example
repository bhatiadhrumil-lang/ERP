# ============================================================
# Mini ERP frontend — environment variables
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# AWS region hosting the Cognito User Pool.
# These are PUBLIC configuration values, not secrets — they ship to the
# browser so the Amplify SDK can talk to Cognito directly.
VITE_AWS_REGION=us-east-1

# Cognito User Pool ID (e.g. us-east-1_AbCdEfGhI) and App Client ID.
# The App Client must be a public client (no client secret) and must NOT
# have "Generate a client secret" enabled.
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Only set to true if the User Pool allows self-registration
# (guest sign-up). Controls whether the "Create an account" link is shown.
VITE_COGNITO_ALLOW_SIGNUP=false

# Optional: backend API base URL. Defaults to "/api" (proxied by the Vite
# dev server to http://localhost:5000/api).
# VITE_API_BASE_URL=/api
