# ============================================================
# Mini ERP backend — environment variables
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# Local development PostgreSQL.
# Production: point this at Amazon RDS (see README "SSH tunnel" for private RDS).
DATABASE_URL="postgresql://mini_erp:mini_erp_dev_password@localhost:5432/mini_erp"

# Separate database for the automated test suite.
TEST_DATABASE_URL="postgresql://mini_erp:mini_erp_dev_password@localhost:5432/mini_erp_test"

PORT=5000
NODE_ENV=development
# Comma-separated list of allowed origins (ALB/frontend domain in production).
CORS_ORIGIN=http://localhost:5173

# ---- AWS Cognito (production authentication) ----
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ---- Development authentication (NEVER used in production) ----
# When NODE_ENV=development, the backend can issue locally-signed JWTs via
# POST /api/auth/dev-login so the app is usable without Cognito.
# Production always validates Cognito JWTs; the dev endpoint is not mounted.
DEV_JWT_SECRET=change-me-to-a-long-random-string-in-local-env
DEV_AUTH_ENABLED=true