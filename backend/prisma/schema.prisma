// Mini ERP — Prisma schema (PostgreSQL)
// The Prisma schema is the source of truth for the database.
// Production target: Amazon RDS PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

/**
 * Application-side user lifecycle. Cognito owns credentials; this enum owns
 * the ERP-side invitation state:
 *  - INVITED  : admin created the Cognito identity, employee has not completed
 *               first-time password setup yet
 *  - ACTIVE   : onboarding completed (first authenticated request flips INVITED)
 *  - DISABLED : admin disabled the account — app authorization rejects these
 */
enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MovementType {
  IN
  OUT
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Users
// Cognito owns credentials. No passwords are ever stored here.
// cognitoSub maps the Cognito identity to the application user.
// ---------------------------------------------------------------------------

model User {
  id               String               @id @default(uuid())
  cognitoSub       String               @unique
  name             String
  email            String               @unique
  role             UserRole
  status           UserStatus           @default(ACTIVE)
  isActive         Boolean              @default(true)
  // Dev-mode only: scrypt hash of the temp password for locally-created
  // accounts (invites without AWS Cognito). Never selected into API responses.
  // Null for real Cognito users — Cognito owns their credentials.
  devPasswordHash  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  assignedFollowUps CustomerFollowUp[]  @relation("AssignedFollowUps")
  createdFollowUps  CustomerFollowUp[]  @relation("CreatedFollowUps")
  inventoryMovements InventoryMovement[]
  salesChallans     SalesChallan[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Customers (CRM)
// ---------------------------------------------------------------------------

model Customer {
  id               String             @id @default(uuid())
  customerCode     String             @unique
  name             String
  mobile           String
  email            String?
  businessName     String
  gstNumber        String?
  customerType     CustomerType
  status           CustomerStatus     @default(LEAD)
  address          String?
  nextFollowUpDate DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  followUps        CustomerFollowUp[]
  salesChallans    SalesChallan[]

  @@index([name])
  @@index([mobile])
  @@index([status])
  @@index([customerType])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Customer follow-ups
// ---------------------------------------------------------------------------

model CustomerFollowUp {
  id           String         @id @default(uuid())
  customerId   String
  assignedToId String?
  createdById  String?
  followUpDate DateTime
  notes        String
  status       FollowUpStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo   User?          @relation("AssignedFollowUps", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("CreatedFollowUps", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([followUpDate])
  @@index([status])
  @@map("customer_follow_ups")
}

// ---------------------------------------------------------------------------
// Products (master data)
// Money is stored as Decimal(12,2) — never Float.
// ---------------------------------------------------------------------------

model Product {
  id               String             @id @default(uuid())
  sku              String             @unique
  name             String
  category         String
  unitPrice        Decimal            @db.Decimal(12, 2)
  minimumStock     Int                @default(5)
  warehouseLocation String
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  inventory        Inventory?
  movements        InventoryMovement[]
  challanItems     SalesChallanItem[]

  @@index([name])
  @@index([category])
  @@index([isActive])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Inventory — the single source of current stock per product (1:1 with Product)
// ---------------------------------------------------------------------------

model Inventory {
  id        String   @id @default(uuid())
  productId String   @unique
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// ---------------------------------------------------------------------------
// Inventory movements — the stock audit ledger.
// Every inventory change MUST create a movement record.
// ---------------------------------------------------------------------------

model InventoryMovement {
  id           String       @id @default(uuid())
  productId    String
  quantity     Int
  movementType MovementType
  reason       String
  createdById  String?
  createdAt    DateTime     @default(now())

  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
  @@index([movementType])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Sales challans
// ---------------------------------------------------------------------------

model SalesChallan {
  id            String            @id @default(uuid())
  challanNumber String            @unique
  customerId    String
  totalQuantity Int
  status        ChallanStatus     @default(DRAFT)
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items         SalesChallanItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("sales_challans")
}

// ---------------------------------------------------------------------------
// Sales challan items — carry snapshots of product name/SKU/price so that
// historical challans stay correct even when the Product master changes later.
// ---------------------------------------------------------------------------

model SalesChallanItem {
  id                 String      @id @default(uuid())
  challanId          String
  productId          String
  productNameSnapshot String
  skuSnapshot        String
  unitPriceSnapshot  Decimal     @db.Decimal(12, 2)
  quantity           Int
  createdAt          DateTime    @default(now())

  challan            SalesChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  product            Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([challanId])
  @@index([productId])
  @@map("sales_challan_items")
}